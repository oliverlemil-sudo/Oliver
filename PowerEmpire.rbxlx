local arenaFloor = block(Vector3.new(1.5, ARENA_RADIUS * 2, ARENA_RADIUS * 2), CFrame.new(ARENA_CENTER + Vector3.new(0, 0.75, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(150, 40, 40), Enum.Material.Slate)
