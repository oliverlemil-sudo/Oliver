local menu = Instance.new("Frame")
menu.BackgroundTransparency = 1
menu.Size = UDim2.new(0, 140, 0, 384)
menu.Position = UDim2.new(1, -150, 0.5, -180)
menu.Parent = gui
local menuItems = {
