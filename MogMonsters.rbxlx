local battle = nil

-- hype words that fly out when you click
local HYPE_WORDS = { "MOG!", "+AURA", "W", "LOCKED IN", "NO CAP", "BEAST MODE", "GOATED", "TOO EASY", "CHAD!", "ALPHA", "+100 AURA", "EZ", "UNSTOPPABLE", "HUGE W", "MAIN CHARACTER" }
local HYPE_COLORS = {
	Color3.fromRGB(255, 80, 90), Color3.fromRGB(255, 200, 50), Color3.fromRGB(90, 220, 255),
	Color3.fromRGB(150, 255, 110), Color3.fromRGB(230, 120, 255), Color3.fromRGB(255, 150, 60),
}
local hypeLayer = Instance.new("Frame")
hypeLayer.Size = UDim2.fromScale(1, 1)
hypeLayer.BackgroundTransparency = 1
hypeLayer.ZIndex = 9
hypeLayer.Parent = gui
local function hypeWord(big)
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	local px, py = 0.28 + math.random() * 0.44, 0.18 + math.random() * 0.32
	l.Position = UDim2.fromScale(px, py)
	l.Size = UDim2.new(0, big and 360 or 240, 0, big and 80 or 54)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = big and "+1000 AURA" or HYPE_WORDS[math.random(1, #HYPE_WORDS)]
	l.TextColor3 = HYPE_COLORS[math.random(1, #HYPE_COLORS)]
	l.Rotation = math.random(-18, 18)
	l.TextStrokeTransparency = 0
	l.Parent = hypeLayer
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = Color3.fromRGB(30, 20, 40)
	st.Parent = l
	local sc = Instance.new("UIScale")
	sc.Scale = 0.4
	sc.Parent = l
	TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(l, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.fromScale(px, py - 0.08), TextTransparency = 1, TextStrokeTransparency = 1,
	}):Play()
	TweenService:Create(st, TweenInfo.new(0.9), { Transparency = 1 }):Play()
	Debris:AddItem(l, 1)
end

-- camera zooms in on the monster during the battle
local savedCameraType = nil
local function battleCamera(part)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return
	end
	savedCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	local toMonster = Vector3.new(part.Position.X - root.Position.X, 0, part.Position.Z - root.Position.Z)
	if toMonster.Magnitude < 0.1 then
		toMonster = Vector3.new(0, 0, -1)
	end
	local dir = toMonster.Unit
	local side = dir:Cross(Vector3.new(0, 1, 0))
	local camPos = root.Position - dir * 7 + side * 4 + Vector3.new(0, 4, 0)
	TweenService:Create(camera, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.lookAt(camPos, part.Position + Vector3.new(0, 1, 0)),
	}):Play()
end
local function restoreCamera()
	if savedCameraType then
		camera.CameraType = savedCameraType
		savedCameraType = nil
	end
end

-- a spinning target circle on the monster
local reticle = nil
local function addReticle(part)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "Reticle"
	bb.Size = UDim2.new(0, 80, 0, 80)
	bb.AlwaysOnTop = true
	bb.Parent = part
	local ring = Instance.new("Frame")
	ring.Size = UDim2.fromScale(1, 1)
	ring.BackgroundTransparency = 1
	ring.Parent = bb
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(1, 0)
	rc.Parent = ring
	local rs = Instance.new("UIStroke")
	rs.Thickness = 4
	rs.Color = Color3.fromRGB(255, 255, 255)
	rs.Transparency = 0.2
	rs.Parent = ring
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 14, 0, 14)
	dot.Position = UDim2.new(0.5, -7, 0.5, -7)
	dot.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
	dot.Parent = bb
	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(1, 0)
	dc.Parent = dot
	reticle = bb
end

local function finishBattle(won)
	local b = battle
	if not b or b.Done then
		return
	end
	b.Done = true
	warnLabel.Text = ""
	if b.Highlight then
		b.Highlight:Destroy()
		b.Highlight = nil
	end
	bTitle.Text = won and "YOU MOGGED IT!" or "IT MOGGED YOU..."
	bTitle.TextColor3 = won and Color3.fromRGB(140, 255, 140) or Color3.fromRGB(255, 110, 110)
	if won and b.Elapsed < 2.2 then
		task.wait(2.2 - b.Elapsed)
	end
	if won then
		hypeWord(true)
	end
	local _, msg = requestRemote:InvokeServer("BattleResult", b.Part, won)
	showMessage(msg or "", won and Color3.fromRGB(110, 255, 110) or Color3.fromRGB(255, 120, 120))
	task.wait(0.8)
	if battle == b then
		battle = nil
		battleFrame.Visible = false
		restoreCamera()
		if reticle then
			reticle:Destroy()
			reticle = nil
		end
	end
end

-- damage numbers that pop out of the monster
local function damageNumber(part, amount, crit)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, crit and 180 or 120, 0, crit and 56 or 40)
	bb.StudsOffset = Vector3.new(math.random(-20, 20) / 10, 2 + math.random() * 2, 0)
	bb.AlwaysOnTop = true
	bb.Parent = part
	local l = label(bb, (crit and "CRIT " or "") .. "-" .. fmt(amount), UDim2.fromScale(1, 1))
	l.TextColor3 = crit and Color3.fromRGB(255, 220, 60) or Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0
	TweenService:Create(bb, TweenInfo.new(0.8), { StudsOffset = bb.StudsOffset + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(bb, 0.9)
end

-- the monster flashes white when you hit it
local function flash(b)
	if typeof(b.Part) ~= "Instance" or not b.Part:IsA("BasePart") then
		return
	end
	if not b.Highlight then
		local h = Instance.new("Highlight")
		h.FillColor = Color3.new(1, 1, 1)
		h.OutlineColor = Color3.new(1, 1, 1)
		h.FillTransparency = 1
		h.OutlineTransparency = 1
		h.Adornee = b.Part
		h.Parent = b.Part
		b.Highlight = h
	end
	b.Highlight.FillTransparency = 0.4
	TweenService:Create(b.Highlight, TweenInfo.new(0.15), { FillTransparency = 1 }):Play()
end

local function hurtMonster(b, amount, crit)
	b.HP = math.max(0, b.HP - amount)
	damageNumber(b.Part, amount, crit)
	flash(b)
	if b.HP <= 0 then
		task.spawn(finishBattle, true)
	end
end

local function useAbility(i)
	local b = battle
	if not b or b.Done or b.Info.Type ~= "Clash" then
		return
	end
	local ab = type(b.Info.Abilities) == "table" and b.Info.Abilities[i]
	if not ab then
		return
	end
	if os.clock() < (abilityReady[ab.Id] or 0) then
		return
	end
	if ab.Id == "Final" and b.HP > b.MaxHP * 0.25 then
		showMessage("FINAL MOG only works when the monster has less than 25% HP!")
		return
	end
	abilityReady[ab.Id] = os.clock() + (ab.Cooldown or 30)
	local w = label(gui, string.upper(ab.Name) .. "!", UDim2.new(0, 520, 0, 80), UDim2.new(0.5, -260, 0.22, 0))
	w.TextColor3 = ABILITY_COLORS[i]
	w.TextStrokeTransparency = 0
	w.ZIndex = 12
	TweenService:Create(w, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(w, 1.1)
	if ab.Id == "Stare" then
		b.Stare = 5
	elseif ab.Id == "Flex" then
		b.StunnedUntil = b.Elapsed + 3
		b.AttackAt = nil
		warnLabel.Text = ""
	elseif ab.Id == "Burst" then
		hurtMonster(b, math.floor(b.MaxHP * 0.15), true)
	elseif ab.Id == "Shield" then
		b.Shield = true
	elseif ab.Id == "Final" then
		hurtMonster(b, b.HP, true)
	end
end

local function dodge()
	local b = battle
	if b and not b.Done and b.AttackAt and not b.Dodged then
		b.Dodged = true
		warnLabel.Text = "DODGED!"
		warnLabel.TextColor3 = Color3.fromRGB(110, 200, 255)
	end
end
dodgeBtn.Activated:Connect(dodge)
for i, b in ipairs(abilityButtons) do
	b.Activated:Connect(function()
		useAbility(i)
	end)
end

local function newGreenZone(b)
	b.ZoneStart = 0.05 + math.random() * (0.9 - b.Info.ZoneWidth)
	greenZone.Position = UDim2.new(b.ZoneStart, 0, 0, 0)
	greenZone.Size = UDim2.new(b.Info.ZoneWidth, 0, 1, 0)
end

local function pop()
	battleScale.Scale = 1.04
	TweenService:Create(battleScale, TweenInfo.new(0.12), { Scale = 1 }):Play()
end

local function battleAction(strength)
	local b = battle
	if not b or b.Done then
		return
	end
	if b.Info.Type == "Clash" then
		local now = os.clock()
		if now - (b.LastClick or 0) < 0.45 then
			b.Combo = (b.Combo or 0) + 1
		else
			b.Combo = 1
		end
		b.LastClick = now
		local dmg = (b.Info.Damage or 1) * (strength or 1) * (1 + math.min(b.Combo, 50) * 0.02)
		local crit = math.random() < 0.1
		if crit then
			dmg = dmg * 2
		end
		if (b.Stare or 0) > 0 then
			b.Stare = b.Stare - 1
			dmg = dmg * 3
			crit = true
		end
		pop()
		hypeWord(false)
		hurtMonster(b, math.max(1, math.floor(dmg)), crit)
	else
		if b.Needle >= b.ZoneStart and b.Needle <= b.ZoneStart + b.Info.ZoneWidth then
			b.Hits = b.Hits + 1
			greenZone.BackgroundColor3 = Color3.new(1, 1, 1)
			task.delay(0.1, function()
				greenZone.BackgroundColor3 = Color3.fromRGB(80, 230, 100)
			end)
			pop()
			hypeWord(false)
			if b.Hits >= 3 then
				task.spawn(finishBattle, true)
				return
			end
			newGreenZone(b)
		else
			b.Misses = b.Misses + 1
			if b.Misses >= 3 then
				task.spawn(finishBattle, false)
			end
		end
	end
end

battleRemote.OnClientEvent:Connect(function(part, info)
	if type(info) ~= "table" then
		return
	end
	battle = {
		Part = part, Info = info, Time = info.Time or 15, Elapsed = 0, Progress = 0.5, Needle = 0, Dir = 1, Hits = 0, Misses = 0, AutoTimer = 0,
		HP = info.HP or 100, MaxHP = math.max(1, info.HP or 100), PlayerHP = 100, NextAttack = info.AttackEvery or 4,
	}
	warnLabel.Text = ""
	bTitle.Text = info.Type == "Clash" and "MOG CLASH!" or "MOG STARE!"
	bTitle.TextColor3 = Color3.fromRGB(255, 225, 70)
	monName.Text = tostring(info.Name)
	monName.TextColor3 = typeof(info.Color) == "Color3" and info.Color or Color3.new(1, 1, 1)
	monCircle.BackgroundColor3 = typeof(info.Color) == "Color3" and info.Color:Lerp(Color3.new(0, 0, 0), 0.25) or Color3.fromRGB(200, 60, 70)
	bPower.Text = info.Type == "Clash" and ("DMG " .. fmt(info.Damage or 1)) or ("Power x" .. tostring(info.ClickMult or 1))
	local clash = info.Type == "Clash"
	fill.Visible = clash
	knob.Visible = clash
	greenZone.Visible = not clash
	needle.Visible = not clash
	bar.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
	redGrad.Enabled = false
	greenGrad.Color = ColorSequence.new(Color3.fromRGB(255, 120, 90), Color3.fromRGB(200, 30, 50)) -- monster HP
	meterBack.Visible = clash
	dodgeBtn.Visible = clash
	for i, b in ipairs(abilityButtons) do
		local ab = clash and type(info.Abilities) == "table" and info.Abilities[i]
		b.Visible = ab and true or false
	end
	if clash then
		bHelp.Text = "CLICK / TAP / SPACE fast - DODGE (Q) when it attacks!"
	else
		bHelp.Text = "CLICK when the needle is in the GREEN zone! (3 times)"
		newGreenZone(battle)
	end
	battleFrame.Visible = true
	battleCamera(part)
	if reticle then
		reticle:Destroy()
	end
	addReticle(part)
end)

quitBtn.Activated:Connect(function()
	task.spawn(finishBattle, false)
end)
-- click / tap ANYWHERE on the screen, or press space
UserInputService.InputBegan:Connect(function(input, processed)
	if not battle then
		return
	end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch or (not processed and input.KeyCode == Enum.KeyCode.Space) then
		battleAction(1)
	elseif not processed and input.KeyCode == Enum.KeyCode.Q then
		dodge()
	elseif not processed and input.KeyCode then
		for i, key in ipairs(ABILITY_KEYS) do
			if input.KeyCode == Enum.KeyCode[key] then
				useAbility(i)
			end
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if reticle then
		local ring = reticle:FindFirstChildOfClass("Frame")
		if ring then
			ring.Rotation = ((ring.Rotation or 0) + dt * 120) % 360
		end
	end
	local b = battle
	if not b or b.Done then
		return
	end
	b.Elapsed = b.Elapsed + dt
	local left = b.Time - b.Elapsed
	bTimer.Text = string.format("%.1fs", math.max(0, left))
	if b.Info.Type == "Clash" then
		if autoMog then
			b.AutoTimer = b.AutoTimer + dt
			if b.AutoTimer >= 0.25 then -- auto mog clicks 4 times per second
				b.AutoTimer = 0
				battleAction(0.6) -- auto mog is weaker than clicking yourself
			end
		end
		if b.Done then
			return
		end
		-- the monster attacks you! (unless it is stunned)
		local stunned = b.StunnedUntil and b.Elapsed < b.StunnedUntil
		if stunned then
			b.NextAttack = math.max(b.NextAttack, b.StunnedUntil)
		elseif not b.AttackAt and b.Elapsed >= b.NextAttack then
			b.AttackAt = b.Elapsed + 1.1
			b.Dodged = false
			warnLabel.Text = "!! IT ATTACKS - DODGE (Q) !!"
			warnLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
		end
		if b.AttackAt and b.Elapsed >= b.AttackAt then
			b.AttackAt = nil
			b.NextAttack = b.Elapsed + (b.Info.AttackEvery or 4)
			if b.Dodged then
				warnLabel.Text = ""
			elseif b.Shield then
				b.Shield = false
				warnLabel.Text = "BLOCKED BY SIGMA SHIELD!"
				warnLabel.TextColor3 = Color3.fromRGB(80, 220, 255)
			else
				b.PlayerHP = b.PlayerHP - (b.Info.AttackDamage or 20)
				warnLabel.Text = "OUCH! -" .. (b.Info.AttackDamage or 20) .. " MOG METER"
				warnLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
				battleScale.Scale = 0.96
				TweenService:Create(battleScale, TweenInfo.new(0.2), { Scale = 1 }):Play()
			end
			task.delay(0.8, function()
				if battle == b and not b.AttackAt then
					warnLabel.Text = ""
				end
			end)
			if b.PlayerHP <= 0 then
				warnLabel.Text = ""
				task.spawn(finishBattle, false)
				return
			end
		end
		local p = math.clamp(b.HP / b.MaxHP, 0, 1)
		fill.Size = UDim2.new(p, 0, 1, 0)
		knob.Position = UDim2.new(p, 0, 0.5, 0)
		local m = math.clamp(b.PlayerHP / 100, 0, 1)
		meterFill.Size = UDim2.new(m, 0, 1, 0)
		meterFill.BackgroundColor3 = Color3.fromRGB(230, 70, 70):Lerp(Color3.fromRGB(90, 220, 110), m)
		meterText.Text = "YOUR MOG METER " .. math.max(0, math.floor(b.PlayerHP)) .. "%" .. (b.Shield and "  🛡" or "")
		if b.Combo and b.Combo > 1 and os.clock() - (b.LastClick or 0) < 0.45 then
			bScore.Text = "COMBO x" .. b.Combo .. ((b.Stare or 0) > 0 and "  x3!" or "")
			bScore.TextColor3 = Color3.fromRGB(255, 220, 60)
		else
			bScore.Text = fmt(b.HP) .. " / " .. fmt(b.MaxHP) .. " HP"
			bScore.TextColor3 = Color3.new(1, 1, 1)
		end
		for i, btn in ipairs(abilityButtons) do
			local ab = type(b.Info.Abilities) == "table" and b.Info.Abilities[i]
			if ab then
				local wait = (abilityReady[ab.Id] or 0) - os.clock()
				if wait > 0 then
					btn.Text = ABILITY_KEYS[i] .. ": " .. math.ceil(wait) .. "s"
					btn.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
				else
					btn.Text = ABILITY_KEYS[i] .. ": " .. ab.Name
					btn.BackgroundColor3 = ABILITY_COLORS[i]
				end
			end
		end
	else
		b.Needle = b.Needle + b.Dir * (b.Info.Speed or 1) * dt
		if b.Needle >= 1 then
			b.Needle, b.Dir = 1, -1
		elseif b.Needle <= 0 then
			b.Needle, b.Dir = 0, 1
		end
		needle.Position = UDim2.new(b.Needle, -4, 0, 0)
		if autoMog then
			local mid = b.ZoneStart + b.Info.ZoneWidth / 2
			if math.abs(b.Needle - mid) < b.Info.ZoneWidth * 0.2 then
				b.AutoTimer = b.AutoTimer + dt
				if b.AutoTimer > 0.05 then
					b.AutoTimer = -0.5
					battleAction(1)
				end
			end
		end
		bScore.Text = "Hits " .. b.Hits .. "/3   Misses " .. b.Misses .. "/3"
	end
	if left <= 0 then
		task.spawn(finishBattle, false)
	end
end)

----------------------------------------------------------------------
-- PANELS
----------------------------------------------------------------------
local panels = {}

local function makePanel(title, color, bottomSpace)
	local frame = box(gui, UDim2.new(0, 480, 0, 440), UDim2.new(0.5, -240, 0.5, -220), Color3.fromRGB(28, 28, 42))
	frame.Visible = false
	frame.ZIndex = 5
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 58)
	bar.BackgroundColor3 = Color3.new(1, 1, 1)
	bar.Parent = frame
	corner(bar, 12)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(color or Color3.fromRGB(120, 120, 255), (color or Color3.fromRGB(120, 120, 255)):Lerp(Color3.new(0, 0, 0), 0.4))
	g.Parent = bar
	local t = label(frame, title, UDim2.new(1, -80, 0, 44), UDim2.new(0, 16, 0, 8))
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextXAlignment = Enum.TextXAlignment.Left
	local close = button(frame, "X", Color3.fromRGB(220, 60, 60), UDim2.new(0, 44, 0, 44), UDim2.new(1, -56, 0, 8))
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -24, 1, -70 - (bottomSpace or 0))
	list.Position = UDim2.new(0, 12, 0, 60)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 8
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = frame
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local panel = { Frame = frame, List = list, Order = 0 }
	function panel.Clear()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		panel.Order = 0
	end
	function panel.Row(height)
		panel.Order = panel.Order + 1
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, -12, 0, height or 52)
		f.BackgroundColor3 = Color3.fromRGB(55, 55, 75)
		f.LayoutOrder = panel.Order
		f.Parent = list
		corner(f, 10)
		return f
	end
	function panel.Text(text, color, height)
		local f = panel.Row(height or 30)
		f.BackgroundTransparency = 1
		local l = label(f, text, UDim2.fromScale(1, 1))
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = color or Color3.new(1, 1, 1)
		return l
	end
	function panel.ButtonRow(text, btnText, btnColor, onClick)
		local f = panel.Row()
		local l = label(f, text, UDim2.new(0.62, -10, 0.7, 0), UDim2.new(0, 10, 0.15, 0))
		l.TextXAlignment = Enum.TextXAlignment.Left
		local b = button(f, btnText, btnColor, UDim2.new(0.35, 0, 0.8, 0), UDim2.new(0.63, 0, 0.1, 0))
		if onClick then
			b.Activated:Connect(onClick)
		end
		return b, l
	end
	table.insert(panels, panel)
	return panel
end

local function openPanel(panel, refresh)
	for _, p in ipairs(panels) do
		p.Frame.Visible = false
	end
	panel.Frame.Visible = true
	if refresh then
		refresh()
	end
end

local function getInfo()
	local ok, info = requestRemote:InvokeServer("GetInfo")
	if ok then
		return info
	end
	return nil
end

local GREEN, GRAY = Color3.fromRGB(40, 170, 80), Color3.fromRGB(90, 90, 90)

----------------------------------------------------------------------
-- CARD SHOPS (pretty cards side by side)
----------------------------------------------------------------------
local TIER_COLORS = {
	Common = { Color3.fromRGB(190, 195, 205), Color3.fromRGB(120, 125, 140) },
	Rare = { Color3.fromRGB(100, 185, 255), Color3.fromRGB(40, 90, 210) },
	Epic = { Color3.fromRGB(210, 120, 255), Color3.fromRGB(120, 40, 210) },
	Legendary = { Color3.fromRGB(255, 215, 80), Color3.fromRGB(240, 120, 20) },
	Mythic = { Color3.fromRGB(255, 100, 160), Color3.fromRGB(200, 30, 90) },
	Secret = { Color3.fromRGB(70, 70, 85), Color3.fromRGB(15, 15, 20) },
	Divine = "rainbow",
}
local RAINBOW_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 230, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(70, 160, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 80, 255)),
})

local function gradient(parent, colors, rotation)
	local g = Instance.new("UIGradient")
	if colors == "rainbow" then
		g.Color = RAINBOW_SEQ
	else
		g.Color = ColorSequence.new(colors[1], colors[2])
	end
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

-- spinning 3D previews inside cards
local spinners = {}
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for model, info in pairs(spinners) do
		if not model.Parent then
			spinners[model] = nil
		else
			model:PivotTo(CFrame.new(0, math.sin(t * 2) * 0.15, 0) * CFrame.Angles(0, t * 1.2, 0))
			if info.Rainbow then
				local c = Color3.fromHSV((t * 0.3) % 1, 0.8, 1)
				for _, p in ipairs(info.Rainbow) do
					p.Color = c
				end
			end
		end
	end
end)

local function viewport(parent)
	local vf = Instance.new("ViewportFrame")
	vf.Size = UDim2.fromScale(1, 1)
	vf.BackgroundTransparency = 1
	vf.Ambient = Color3.fromRGB(200, 200, 200)
	vf.LightColor = Color3.new(1, 1, 1)
	vf.LightDirection = Vector3.new(-1, -1, -1)
	vf.Parent = parent
	local cam = Instance.new("Camera")
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.6, -9), Vector3.new(0, 0, 0))
	cam.FieldOfView = 45
	cam.Parent = vf
	vf.CurrentCamera = cam
	local model = Instance.new("Model")
	model.Parent = vf
	return vf, model
end

local function vpPart(model, size, cf, color, material, shape, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.Transparency = transparency or 0
	p.Parent = model
	if not model.PrimaryPart then
		model.PrimaryPart = p
	end
	return p
end

-- a little player figure with an aura around it
local function auraPreview(parent, color, rainbow)
	local _, model = viewport(parent)
	local body = Color3.fromRGB(235, 235, 240)
	vpPart(model, Vector3.new(2, 2, 1), CFrame.new(0, 0, 0), body)
	vpPart(model, Vector3.new(1.25, 1.25, 1.25), CFrame.new(0, 1.65, 0), Color3.fromRGB(255, 220, 180), nil, Enum.PartType.Ball)
	for _, sx in ipairs({ -1, 1 }) do
		vpPart(model, Vector3.new(1, 2, 1), CFrame.new(sx * 1.5, 0, 0), body)
		vpPart(model, Vector3.new(1, 2, 1), CFrame.new(sx * 0.5, -2, 0), Color3.fromRGB(80, 90, 120))
	end
	local glow = {}
	table.insert(glow, vpPart(model, Vector3.new(6.2, 6.2, 6.2), CFrame.new(0, 0, 0), color, Enum.Material.Neon, Enum.PartType.Ball, 0.78))
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		table.insert(glow, vpPart(model, Vector3.new(0.5, 0.5, 0.5), CFrame.new(math.cos(a) * 2.6, math.sin(a * 2) * 1.8, math.sin(a) * 2.6), color, Enum.Material.Neon, Enum.PartType.Ball))
	end
	spinners[model] = { Rainbow = rainbow and glow or nil }
end

local function makeCardPanel(title, headerColors)
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.82, 0.66)
	frame.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
	frame.Visible = false
	frame.ZIndex = 5
	frame.Parent = gui
	corner(frame, 18)
	local st = Instance.new("UIStroke")
	st.Thickness = 4
	st.Color = Color3.fromRGB(15, 15, 22)
	st.Parent = frame
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(860, 480)
	limit.MinSize = Vector2.new(400, 320)
	limit.Parent = frame

	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, 58)
	header.BackgroundColor3 = Color3.new(1, 1, 1)
	header.Parent = frame
	corner(header, 18)
	gradient(header, headerColors, 0)
	local t = label(header, title, UDim2.new(1, -90, 0.8, 0), UDim2.new(0, 18, 0.1, 0))
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextStrokeTransparency = 0
	local close = button(header, "X", Color3.fromRGB(230, 60, 60), UDim2.new(0, 46, 0, 46), UDim2.new(1, -56, 0, 6))
	close.Activated:Connect(function()
		frame.Visible = false
	end)

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -24, 1, -74)
	list.Position = UDim2.new(0, 12, 0, 66)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 8
	list.ScrollingDirection = Enum.ScrollingDirection.X
	list.AutomaticCanvasSize = Enum.AutomaticSize.X
	list.CanvasSize = UDim2.new()
	list.Parent = frame
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 12)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = list

	local panel = { Frame = frame, List = list, Order = 0 }
	function panel.Clear()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		panel.Order = 0
	end
	-- opts: Title, Tag, Colors, Icon, Preview(function(area)), Badge, Info, Button, ButtonColor, OnClick, Wide
	function panel.Card(opts)
		panel.Order = panel.Order + 1
		local card = Instance.new("Frame")
		card.Size = UDim2.new(0, opts.Wide and 300 or 172, 1, -14)
		card.BackgroundColor3 = Color3.new(1, 1, 1)
		card.LayoutOrder = panel.Order
		card.Parent = list
		corner(card, 16)
		gradient(card, opts.Colors or TIER_COLORS.Common, 90)
		local cs = Instance.new("UIStroke")
		cs.Thickness = 3
		cs.Color = Color3.fromRGB(255, 255, 255)
		cs.Transparency = 0.2
		cs.Parent = card

		local ttl = label(card, opts.Title or "", UDim2.new(1, -12, 0.11, 0), UDim2.new(0, 6, 0.02, 0))
		ttl.TextStrokeTransparency = 0
		if opts.Tag then
			local tag = label(card, opts.Tag, UDim2.new(1, -12, 0.07, 0), UDim2.new(0, 6, 0.13, 0))
			tag.TextColor3 = opts.TagColor or Color3.new(1, 1, 1)
			tag.TextStrokeTransparency = 0.2
		end
		local area = Instance.new("Frame")
		area.Size = UDim2.new(1, -16, 0.42, 0)
		area.Position = UDim2.new(0, 8, 0.21, 0)
		area.BackgroundColor3 = Color3.new(0, 0, 0)
		area.BackgroundTransparency = 0.75
		area.Parent = card
		corner(area, 12)
		if opts.Preview then
			opts.Preview(area)
		elseif opts.Icon then
			local ic = label(area, opts.Icon, UDim2.fromScale(0.9, 0.9), UDim2.fromScale(0.05, 0.05))
			ic.TextStrokeTransparency = 1
		end
		if opts.Lines then
			local txt = label(area, table.concat(opts.Lines, "\n"), UDim2.new(1, -12, 1, -8), UDim2.new(0, 6, 0, 4))
			txt.TextXAlignment = Enum.TextXAlignment.Left
			txt.TextYAlignment = Enum.TextYAlignment.Top
		end
		if opts.Badge then
			local pill = Instance.new("Frame")
			pill.Size = UDim2.new(0.86, 0, 0.1, 0)
			pill.Position = UDim2.new(0.07, 0, 0.65, 0)
			pill.BackgroundColor3 = opts.BadgeColor or Color3.fromRGB(70, 210, 100)
			pill.Parent = card
			corner(pill, 10)
			stroke(pill)
			label(pill, opts.Badge, UDim2.new(1, -8, 0.86, 0), UDim2.new(0, 4, 0.07, 0))
		end
		if opts.Info then
			local inf = label(card, opts.Info, UDim2.new(1, -12, 0.07, 0), UDim2.new(0, 6, 0.76, 0))
			inf.TextStrokeTransparency = 0.2
		end
		local b = button(card, opts.Button or "", opts.ButtonColor or Color3.fromRGB(60, 200, 90), UDim2.new(0.86, 0, 0.13, 0), UDim2.new(0.07, 0, 0.84, 0))
		if opts.OnClick then
			b.Activated:Connect(opts.OnClick)
		end
		return card, b
	end
	table.insert(panels, panel)
	return panel
end

local BUY_GREEN = Color3.fromRGB(60, 200, 90)
local EQUIP_BLUE = Color3.fromRGB(60, 140, 240)
local DONE_GRAY = Color3.fromRGB(110, 110, 120)

----------------------------------------------------------------------
-- SHOP (Robux)
----------------------------------------------------------------------
local shopPanel = makeCardPanel("ROBUX SHOP", { Color3.fromRGB(60, 210, 110), Color3.fromRGB(20, 140, 200) })

local function promptBuy(attr, isPass)
	local id = ReplicatedStorage:GetAttribute(attr) or 0
	if id == 0 then
		showMessage("Coming soon!")
		return
	end
	if isPass then
		MarketplaceService:PromptGamePassPurchase(player, id)
	else
		MarketplaceService:PromptProductPurchase(player, id)
	end
end

local SHOP_ITEMS = {
	{ Title = "2x MONEY", Icon = "💰", Info = "Forever!", Badge = "x2 Money", Attr = "DoubleMoneyPassId", Pass = true, Owned = "DoubleMoney", Tier = "Legendary" },
	{ Title = "2x MOG", Icon = "💪", Info = "Forever!", Badge = "x2 MOG", Attr = "DoubleMogPassId", Pass = true, Owned = "DoubleMog", Tier = "Mythic" },
	{ Title = "VIP", Icon = "👑", Info = "Tag + 2x daily", Badge = "+20% Money", Attr = "VipPassId", Pass = true, Owned = "VIP", Tier = "Divine" },
	{ Title = "BIG ENCLOSURE", Icon = "🏠", Info = "Forever!", Badge = "+5 Monsters", Attr = "ExtraSlotsPassId", Pass = true, Owned = "ExtraSlots", Tier = "Rare" },
	{ Title = "SERVER LUCK", Icon = "🍀", Info = "15 min, everyone!", Badge = "x2 Luck", Attr = "ServerLuckProductId", Tier = "Epic" },
	{ Title = "CASH PACK", Icon = "💵", Info = "10 min of income", Badge = "Instant cash", Attr = "CashPackProductId", Tier = "Common" },
}

local POTION_ITEMS = {
	{ Id = "XP", Title = "2x XP POTION", Icon = "🧪", Info = "15 minutes", Badge = "x2 XP", Gems = 25, Tier = "Rare" },
	{ Id = "Coins", Title = "2x COINS POTION", Icon = "⚗️", Info = "10 minutes", Badge = "x2 Money", Gems = 40, Tier = "Legendary" },
}

local function refreshShop()
	shopPanel.Clear()
	for _, item in ipairs(POTION_ITEMS) do
		shopPanel.Card({
			Title = item.Title, Tag = "Gem potion", Colors = TIER_COLORS[item.Tier], Icon = item.Icon,
			Badge = item.Badge, Info = item.Info, Button = "💎 " .. item.Gems, ButtonColor = Color3.fromRGB(40, 160, 220),
			OnClick = function()
				local _, msg = requestRemote:InvokeServer("BuyPotion", item.Id)
				showMessage(msg, Color3.fromRGB(255, 160, 255))
			end,
		})
	end
	for _, item in ipairs(SHOP_ITEMS) do
		local owned = item.Owned and player:GetAttribute(item.Owned)
		shopPanel.Card({
			Title = item.Title, Tag = item.Pass and "Game Pass" or "Boost", Colors = TIER_COLORS[item.Tier],
			Icon = item.Icon, Badge = item.Badge, Info = item.Info,
			Button = owned and "OWNED" or "R$ BUY", ButtonColor = owned and DONE_GRAY or BUY_GREEN,
			OnClick = function()
				if not owned then
					promptBuy(item.Attr, item.Pass)
				end
			end,
		})
	end
end
player.AttributeChanged:Connect(function(name)
	if shopPanel.Frame.Visible and (name == "DoubleMoney" or name == "DoubleMog" or name == "VIP" or name == "ExtraSlots") then
		refreshShop()
	end
end)

