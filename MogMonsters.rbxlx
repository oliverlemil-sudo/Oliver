bTimer.TextXAlignment = Enum.TextXAlignment.Left
local bScore = label(battleFrame, "", UDim2.new(0.5, -20, 0, 26), UDim2.new(0.5, 0, 0, 142))
bScore.TextXAlignment = Enum.TextXAlignment.Right
