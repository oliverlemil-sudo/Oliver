task.delay(2, function()
	showMessage("Welcome to MOG MONSTERS! Train at your MOG STONE, then win MOG BATTLES on the MOG ROAD!", Color3.fromRGB(255, 210, 60))
end)

print("MOG MONSTERS client v6 started OK!")
