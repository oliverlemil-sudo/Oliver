local rebirthPanel = makePanel("REBIRTH", Color3.fromRGB(255, 255, 255), 80)
local rebirthBtn = button(rebirthPanel.Frame, "REBIRTH!", Color3.fromRGB(255, 170, 40), UDim2.new(0.6, 0, 0, 56), UDim2.new(0.2, 0, 1, -72))

