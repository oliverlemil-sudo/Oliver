-- WELCOME
----------------------------------------------------------------------
task.delay(2, function()
	showMessage("Welcome to MOG MONSTERS! Train at your MOG STONE, then win MOG BATTLES and lead monsters home!", Color3.fromRGB(255, 210, 60))
end)

print("MOG MONSTERS client v8 started OK!")
