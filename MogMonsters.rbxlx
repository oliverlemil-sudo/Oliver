	{ Every = 30,  Max = 6 },
	{ Every = 60,  Max = 4 },
	{ Every = 180, Max = 3 },
	{ Every = nil, Max = 1 }, -- GODLY zone: only a GIGAMOG (1 in a billion per spawn)
